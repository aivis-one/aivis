# =============================================================================
# AIVIS.ONE -- Repository .gitignore
# =============================================================================

# -- Secrets --
.env
# ...and every projection of it. scripts/env-render.sh generates
# backend/.env.db and backend/.env.storage on every install and every
# update; untracked, they would show up in `git status --porcelain`, and
# the update cycle reads that to decide whether the tree is dirty -- so
# without this line every `aivis update` would stop and ask a human
# whether to discard two files it had just written itself.
.env.*
*.pem
*.key

# -- Python --
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/

# -- Run artefacts --
# Redis writes its snapshot into the working directory of whoever
# started it, which on a bare stand is the repository root. It turned up
# in four delivery reports as an unexplained untracked file before this
# line existed; an untracked file in the root is not cosmetic here,
# because `aivis update` reads `git status --porcelain` to decide the
# tree is dirty and stops to ask.
dump.rdb
*.rdb

# -- Tool caches --
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# -- Node / Frontend --
node_modules/
dist/
.vite/
*.local

# -- IDE --
.idea/
.vscode/
*.swp
*.swo
*~

# -- OS --
.DS_Store
Thumbs.db

# Claude Code harness config. Tool state, not product code -- the repo has
# never tracked it, and leaving it untracked makes every `git status` read
# as a dirty tree.
.claude/
/docs/
checks/ds-copies-*/

# -- Check fixtures: a --selftest builds its throwaway tree in checks/<name>-XXXX and removes it --
/checks/breakpoints-*/
/checks/comms_profile-*/
/checks/deploy-addresses-*/
/checks/preauth-*/
/checks/reftruth-*/
/checks/routes-*/
/checks/shell_layout-*/
/checks/tokens-*/
