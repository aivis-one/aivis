# =============================================================================
# AIVIS.ONE -- Repository .gitignore
# =============================================================================

# -- Secrets --
.env
# ...and every projection of it. scripts/env-render.sh generates
# backend/.env.db and backend/.env.minio on every install and every
# update; untracked, they would show up in `git status --porcelain`, and
# the update cycle reads that to decide whether the tree is dirty -- so
# without this line every `aivis update` would stop and ask a human
# whether to discard two files it had just written itself.
.env.*
*.pem
*.key

# -- Python --
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/

# -- Tool caches --
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# -- Node / Frontend --
node_modules/
dist/
.vite/
*.local

# -- IDE --
.idea/
.vscode/
*.swp
*.swo
*~

# -- OS --
.DS_Store
Thumbs.db

# -- Design system SOURCE (owner-supplied, working copy, never published) --
# Upstream lives outside this repo, on the owner's drive. This folder is a COPY
# kept beside the frontend so the token set and the marks can be worked against.
# It is the SOURCE we translate FROM; what the product ships is the tracked
# frontend under frontend/src. Owner-instructed 2026-08-16.
_design-source/

# Claude Code harness config. Tool state, not product code -- the repo has
# never tracked it, and leaving it untracked makes every `git status` read
# as a dirty tree.
.claude/
