{
  "name": "cbshome-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "type-check": "vue-tsc --noEmit",
    "prepare": "cd ../.. && husky"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "lucide-vue-next": "^0.460",
    "pinia": "^2.3",
    "vue": "^3.5",
    "vue-i18n": "^10.0",
    "vue-router": "^4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.0",
    "@vitejs/plugin-vue": "^5.2",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.17",
    "eslint-plugin-vue": "^9.32",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.4",
    "typescript": "^5.7",
    "typescript-eslint": "^8.18",
    "vite": "^6.0",
    "vite-plugin-pwa": "^0.21",
    "vitest": "^4.1.4",
    "vue-tsc": "^2.2"
  }
}
