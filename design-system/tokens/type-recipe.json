{
 "families": {
  "display": {
   "token": "--font-display",
   "family": "Commissioner",
   "weights": [
    700,
    800
   ],
   "use": "headings and display lines"
  },
  "body": {
   "token": "--font-body",
   "family": "Inter",
   "weights": [
    400,
    600,
    700
   ],
   "use": "text, controls, captions"
  },
  "mono": {
   "token": "--font-mono",
   "family": "JetBrains Mono",
   "weights": [
    400,
    700
   ],
   "use": "figures: amounts, counts, identifiers, code"
  },
  "arabic": {
   "token": "all three stacks",
   "family": "Noto Sans Arabic",
   "weights": "400 to 700 (one variable file per slice)",
   "use": "Arabic script, placed after the Latin family in every stack"
  }
 },
