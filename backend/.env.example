# =============================================================================
# CBSHOME Backend -- Environment Variables Example
# =============================================================================
# Copy to .env and fill in values before running.
# Never commit .env to git.
# =============================================================================

# -- Application --
APP_ENV=development          # development | production
LOG_LEVEL=INFO
CORS_ORIGINS=*               # production: https://cbshome.org

# -- Database --
DATABASE_URL=postgresql+asyncpg://cbshome:cbshome@db:5432/cbshome
POSTGRES_DB=cbshome
POSTGRES_USER=cbshome
POSTGRES_PASSWORD=cbshome

# -- Redis --
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# -- MinIO (S3-compatible object storage) --
# MinIO root credentials are used ONLY by docker-compose to start the server
# and by minio-init to bootstrap buckets / service account.
# Backend NEVER uses root -- it uses the service account (ACCESS_KEY/SECRET_KEY).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Backend service account (created by minio-init in docker-compose).
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Endpoint as seen from inside docker network (backend -> minio).
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=cbshome-attachments
MINIO_REGION=us-east-1
# Presigned URL TTL (seconds): 15 min for auth flow, 24h for public flow.
MINIO_PRESIGNED_TTL_AUTH=900
MINIO_PRESIGNED_TTL_PUBLIC=86400
# Hard limit on uploaded file size (MB). Mirrored in nginx client_max_body_size
# and in backend Pydantic validators.
MINIO_MAX_FILE_SIZE_MB=100
# Password for nginx basic-auth in front of MinIO Web UI
# (login is fixed: 'admin'). Set in install_cbshome.sh.
MINIO_CONSOLE_BASIC_AUTH_PASSWORD=

# -- Auth --
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
SESSION_TTL_DAYS=30
MAX_CONCURRENT_SESSIONS=5

# -- Telegram --
TELEGRAM_BOT_TOKEN=TEST      # set to real token in production

# -- Telegram Auth Security --
AUTH_RATE_LIMIT_MAX_REQUESTS=5       # max auth attempts per telegram_id per window
AUTH_RATE_LIMIT_WINDOW_SECONDS=60    # rate limit window (seconds)
AUTH_INIT_DATA_TTL_SECONDS=300       # initData validity window (5 min)
AUTH_CLOCK_SKEW_SECONDS=60           # tolerance for future auth_date

# -- KYC (SumSub) --
SUMSUB_API_KEY=TEST
SUMSUB_SECRET_KEY=TEST
KYC_WEBHOOK_SECRET=

# -- Crypto Webhook --
CRYPTO_WEBHOOK_SECRET=

# -- Email (SMTP primary, Mailgun fallback) --
SMTP_HOST=host.docker.internal
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@mail.cbshome.org
SMTP_USE_TLS=false
MAILGUN_API_KEY=TEST
MAILGUN_DOMAIN=mail.cbshome.org
MAILGUN_API_URL=https://api.eu.mailgun.net    # change to https://api.mailgun.net for US
HIGH_SECURED_DOMAINS=          # comma-separated: t-online.de,web.de,gmx.de,...

# -- Crypto --
CRYPTO_NETWORKS=TRC20,ERC20,BEP20,PoS
FREEZING_HOURS_CRYPTO=1

# -- Installments --
INSTALLMENT_DEFAULT_DAYS=7
INSTALLMENT_WORKER_HOUR=3

# -- Agent --
AGENT_APPLICATION_COOLDOWN_DAYS=30
